---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import ContactForm from "../components/ContactForm.astro";
import { getLangContent } from "../i18n";

const lang = Astro.currentLocale ?? "tr";
const content = getLangContent(lang);
---

<Layout
    title="İletişim | Bondlio"
    description="Bizimle iletişime geçin."
    currentPage="contact"
>
    <PageHeader
        title="İletişim"
        description="Sorularınız için çekinmeden yazın. Açık ve dürüst iletişim, en iyi başlangıçtır."
    />

    <section class="page-content-container">
        <div class="grid lg:grid-cols-2 gap-16">
            <div>
                <h2
                    class="text-2xl font-display font-semibold text-bondlio-charcoal"
                >
                    Bize kendinizden bahsedin.
                </h2>
                <p class="mt-3 text-bondlio-gray">
                    İster bir aile arıyor olun, ister iş fırsatı — aşağıdaki
                    formu doldurun, ekibimiz en kısa sürede size dönüş yapsın.
                    Her mesaj, gerçek bir kişi tarafından okunur.
                </p>
                <div class="mt-8">
                    <ContactForm />
                </div>
            </div>

            <div>
                <h2
                    class="text-2xl font-display font-semibold text-bondlio-charcoal"
                >
                    Bize Ulaşın
                </h2>
                <p class="mt-3 text-bondlio-gray">
                    Sorularınız için çekinmeden yazın. Açık ve dürüst iletişim,
                    en iyi başlangıçtır.
                </p>

                <div class="mt-8 space-y-6">
                    <div>
                        <h3
                            class="font-display font-semibold text-bondlio-charcoal"
                        >
                            E-mail
                        </h3>
                        <a
                            href="mailto:info@bondlio.com"
                            class="text-bondlio-gray hover:text-bondlio-orange transition-colors duration-150"
                        >
                            info@bondlio.com
                        </a>
                    </div>
                    <div>
                        <h3
                            class="font-display font-semibold text-bondlio-charcoal"
                        >
                            Telefon
                        </h3>
                        <a
                            href={`tel:${content.contactInfo.phone}`}
                            class="text-bondlio-gray hover:text-bondlio-orange transition-colors duration-150"
                        >
                            {content.contactInfo.phoneDisplay} - Türkçe
                        </a>
                    </div>
                    <div>
                        <h3
                            class="font-display font-semibold text-bondlio-charcoal"
                        >
                            WhatsApp
                        </h3>
                        <a
                            href={`https://wa.me/${content.contactInfo.whatsapp}`}
                            target="_blank"
                            rel="noreferrer"
                            class="text-bondlio-gray hover:text-bondlio-orange transition-colors duration-150"
                        >
                            {content.contactInfo.whatsappDisplay} - Türkçe, İngilizce
                        </a>
                        <br />
                        <a
                            href={`https://wa.me/${content.contactInfo.whatsapp2}`}
                            target="_blank"
                            rel="noreferrer"
                            class="text-bondlio-gray hover:text-bondlio-orange transition-colors duration-150"
                        >
                            {content.contactInfo.whatsappDisplay2} - English
                        </a>
                    </div>
                    <div>
                        <h3
                            class="font-display font-semibold text-bondlio-charcoal"
                        >
                            Adres
                        </h3>
                        <p class="text-bondlio-gray">
                            Park Oran Evleri, Çankaya, Ankara, Türkiye
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
