---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ContactForm from "../../components/ContactForm.astro";
import { getLangContent } from "../../i18n";

const lang = Astro.currentLocale ?? "tr";
const content = getLangContent(lang);
---

<Layout
    title="Makipag-ugnayan | Bondlio"
    description="Para sa inyong mga katanungan, huwag mag-atubiling sumulat. Ang bukas at tapat na komunikasyon ay ang pinakamagandang simula."
    currentPage="contact"
>
    <PageHeader
        title="Makipag-ugnayan"
        description="Para sa inyong mga katanungan, huwag mag-atubiling sumulat. Ang bukas at tapat na komunikasyon ay ang pinakamagandang simula."
    />

    <section class="page-content-container">
        <div class="grid lg:grid-cols-2 gap-16">
            <div>
                <h2
                    class="text-2xl font-display font-semibold text-bondlio-charcoal"
                >
                    Makisiguro Ka sa Iyong Sarili.
                </h2>
                <p class="mt-3 text-bondlio-gray">
                    Nag-aampon ka man ng pamilya o naghahanap ng oportunidad sa
                    trabaho — punan ang form sa ibaba, at ang aming team ay
                    tutugon sa iyo sa lalong madaling panahon. Ang bawat mensahe
                    ay binabasa ng isang totoong tao.
                </p>
                <div class="mt-8">
                    <ContactForm />
                </div>
            </div>

            <div>
                <h2
                    class="text-2xl font-display font-semibold text-bondlio-charcoal"
                >
                    Makipag-ugnayan
                </h2>
                <p class="mt-3 text-bondlio-gray">
                    Para sa inyong mga katanungan, huwag mag-atubiling sumulat.
                    Ang bukas at tapat na komunikasyon ay ang pinakamagandang
                    simula.
                </p>

                <div class="mt-8 space-y-6">
                    <div>
                        <h3
                            class="font-display font-semibold text-bondlio-charcoal"
                        >
                            E-mail
                        </h3>
                        <a
                            href="mailto:info@bondlio.com"
                            class="text-bondlio-gray hover:text-bondlio-orange transition-colors duration-150"
                        >
                            info@bondlio.com
                        </a>
                    </div>
                    <div>
                        <h3
                            class="font-display font-semibold text-bondlio-charcoal"
                        >
                            Telepono
                        </h3>
                        <a
                            href={`tel:${content.contactInfo.phone}`}
                            class="text-bondlio-gray hover:text-bondlio-orange transition-colors duration-150"
                        >
                            {content.contactInfo.phoneDisplay}
                        </a>
                    </div>
                    <div>
                        <h3
                            class="font-display font-semibold text-bondlio-charcoal"
                        >
                            WhatsApp
                        </h3>
                        <a
                            href={`https://wa.me/${content.contactInfo.whatsapp}`}
                            target="_blank"
                            rel="noreferrer"
                            class="text-bondlio-gray hover:text-bondlio-orange transition-colors duration-150"
                        >
                            {content.contactInfo.whatsappDisplay}
                        </a>
                        <br />
                        <a
                            href={`https://wa.me/${content.contactInfo.whatsapp2}`}
                            target="_blank"
                            rel="noreferrer"
                            class="text-bondlio-gray hover:text-bondlio-orange transition-colors duration-150"
                        >
                            {content.contactInfo.whatsappDisplay2} (English)
                        </a>
                    </div>
                    <div>
                        <h3
                            class="font-display font-semibold text-bondlio-charcoal"
                        >
                            Address
                        </h3>
                        <p class="text-bondlio-gray">
                            Park Oran Evleri, Çankaya, Ankara, Türkiye
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
