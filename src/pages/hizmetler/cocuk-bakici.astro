---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ServiceProcess from "../../components/ServiceProcess.astro";
import ServiceCTA from "../../components/ServiceCTA.astro";
import { getLangContent } from "../../i18n";

import filipinliCocukBakicisi from "../../assets/filipinli-cocuk-bakicisi.webp";

const lang = Astro.currentLocale ?? "tr";
const content = getLangContent(lang);

const checks = [
    {
        title: "Sabıka Kaydı Kontrolü",
        description: "Her adayın adli sicil kaydı titizlikle incelenir.",
    },
    {
        title: "Referans Kontrolü",
        description:
            "Önceki işverenlerle doğrudan görüşerek geçmiş deneyimler doğrulanır.",
    },
    {
        title: "Detaylı Mülakat",
        description:
            "Yüz yüze görüşmelerle adayın yaklaşımı ve uyumu değerlendirilir.",
    },
    {
        title: "Deneyim ve Sertifika Doğrulama",
        description: "Belgeler ve iş geçmişi tek tek kontrol edilir.",
    },
    {
        title: "İlk Yardım ve Bakım Eğitimi",
        description: "Temel çocuk bakımı ve ilk yardım bilgisi aranır.",
    },
];
---

<Layout
    title="Çocuk Bakıcı Hizmeti | Bondlio"
    description="Titizlikle seçilmiş, güvenilir çocuk bakıcıları."
    currentPage="services.nanny"
>
    <PageHeader
        title="Çocuk Bakıcı"
        description="Tam zamanlı, yatılı ya da esnek — ailenize en uygun düzende, titizlikle seçilmiş çocuk bakıcıları."
    />

    <section class="page-content-container py-10">
        <div class="grid lg:grid-cols-2 gap-25 items-center">
            <div>
                <h2
                    class="text-2xl md:text-3xl font-display font-semibold text-bondlio-charcoal"
                >
                    Bu, sıradan bir işe alım değil.
                </h2>
                <p class="mt-4 text-bondlio-gray text-lg">
                    Aslında sadece bir "<strong>çocuk bakıcısı</strong>"
                    aramıyorsunuz. Evinize, çocuğunuza, güvendiğiniz bir düzene
                    birini davet ediyorsunuz. <strong>Bunu biliyoruz </strong> — çünkü
                    bu kararı hafifçe almadığınızı biliyoruz. Piyasada onlarca ajans
                    var, hepsi "güvenilir" diyor. Biz bunu söylemek yerine, nasıl
                    çalıştığımızı gösteriyoruz: <strong>
                        her adayı sadece belgeleriyle değil,</strong
                    > deneyimiyle, yaklaşımıyla, sizinle ne kadar uyumlu olacağıyla
                    değerlendiriyoruz. Süreç boyunca sizi karanlıkta bırakmıyoruz;
                    ücretlendirmemiz açık, iletişimimiz nettir. Çünkü biliyoruz ki;
                    bu bir eşya değil, <strong>bir insan, ve bir aile</strong> söz
                    konusu.
                </p>
                <p class="mt-6 text-lg text-bondlio-gray">
                    Bir aile için en önemli konulardan biri, çocuk bakıcısının
                    sadece güvenilir değil, aynı zamanda kendi yaşam tarzlarına
                    uyumlu olmasıdır. Bu yüzden adayları sadece geçmiş
                    deneyimleriyle değil, kişisel özellikleriyle ve kültürel
                    değerleriyle de değerlendiriyoruz.Aileden biri olacak kişiyi
                    bulmak için sadece standart bir mülakat değil, aynı zamanda
                    günlük rutinleri ve değerleri anlamaya yönelik bir süreç
                    uyguluyoruz.
                </p>
            </div>
            <div
                class="bg-bondlio-beige rounded-2xl aspect-[4/3] overflow-hidden"
            >
                <img
                    src={filipinliCocukBakicisi.src}
                    alt="Filipinli Çocuk Bakıcısı güvenilir"
                    class="w-full h-full object-cover"
                />
            </div>
        </div>
    </section>

    <ServiceProcess checks={checks} />

    <ServiceCTA />
</Layout>
