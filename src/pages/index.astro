---
import Layout from "../layouts/Layout.astro";
import HeroSlider from "../components/HeroSlider.astro";
import HomeForms from "../components/HomeForms.astro";
import ValueProps from "../components/ValueProps.astro";
import HowItWorks from "../components/HowItWorks.astro";
import ServicesPreview from "../components/ServicesPreview.astro";
import AboutTeaser from "../components/AboutTeaser.astro";
import BlogPreview from "../components/BlogPreview.astro";
---

<Layout
	title="Güvenilir Dadı, Bakıcı ve Ev Temizlikçi Platformu | Bondlio"
	description="Doğru kişiyi bulmak güven ister. Bondlio, hem aileleri hem çalışanları özenle değerlendirerek, yasalara tam uyumlu şekilde güvenli bir eşleşme sağlar."
	currentPage="home"
>
	<HeroSlider />
	<ServicesPreview />
	<HomeForms />
	<HowItWorks />
	<AboutTeaser />
	<BlogPreview />
	<ValueProps />
</Layout>
