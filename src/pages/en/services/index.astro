---
import Layout from "../../../layouts/Layout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import { getLangContent } from "../../../i18n";
import { getServices } from "../../../data/services";
import ServiceCTA from "../../../components/ServiceCTA.astro";

const lang = Astro.currentLocale ?? "tr";
const content = getLangContent(lang);
const services = getServices(content);
---

<Layout
    title="Services | Bondlio"
    description="Childcare, elder care, and cleaning services."
    currentPage="services.index"
>
    <PageHeader
        title="Services"
        description="Choose the service that best suits your needs, and we'll be with you every step of the way."
    />

    <section class="page-content-container py-10">
        <div class="grid md:grid-cols-3 gap-8">
            {
                services.map((service) => (
                    <a
                        href={service.href}
                        class="group block bg-white border border-bondlio-beige rounded-2xl p-8 hover:border-bondlio-orange transition-colors duration-150"
                    >
                        <div class="bg-bondlio-beige rounded-xl aspect-[4/3] overflow-hidden mb-6">
                            <img
                                src={service.image.src}
                                alt={service.title}
                                class="w-full h-full object-cover"
                            />
                        </div>
                        <h2 class="text-xl font-display font-semibold text-bondlio-charcoal">
                            {service.title}
                        </h2>
                        <p class="mt-2 text-bondlio-gray">
                            {service.description}
                        </p>
                        <span class="mt-4 inline-flex items-center gap-1 text-bondlio-orange font-display font-semibold group-hover:gap-2 transition-all duration-150">
                            View Details
                            <svg
                                class="w-4 h-4"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <line x1="5" y1="12" x2="19" y2="12" />
                                <polyline points="12 5 19 12 12 19" />
                            </svg>
                        </span>
                    </a>
                ))
            }
        </div>
    </section>

    <ServiceCTA />
</Layout>
