---
import Layout from "../../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    const enPosts = posts.filter((post) => post.data.lang === "en");
    return enPosts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

import { getLangContent } from "../../../i18n";

const lang = Astro.currentLocale ?? "tr";
const content = getLangContent(lang);

const { post } = Astro.props;
const { Content } = await render(post);

const articleSchema = {
    "@type": "Article",
    "@id": `${Astro.url.href}#article`,
    headline: post.data.title,
    description: post.data.description,
    image: new URL(post.data.coverImage.src, "https://bondlio.com").href,
    datePublished: post.data.publishDate.toISOString(),
    dateModified: (
        post.data.modifiedDate ?? post.data.publishDate
    ).toISOString(),
    author: { "@id": "https://bondlio.com/#organization" },
    publisher: { "@id": "https://bondlio.com/#organization" },
    mainEntityOfPage: Astro.url.href,
    inLanguage: lang,
};
---

<Layout
    title={`${post.data.title} | Bondlio`}
    description={post.data.description}
    currentPage="infobook"
    canonical={Astro.url.href}
    publishDate={post.data.publishDate.toISOString().split("T")[0]}
    modifiedDate={post.data.modifiedDate
        ? post.data.modifiedDate.toISOString().split("T")[0]
        : post.data.publishDate.toISOString().split("T")[0]}
    additionalSchema={articleSchema}
>
    <section class="page-content-container pt-20">
        <div class="max-w-3xl mx-auto pb-8 border-b border-bondlio-beige">
            <nav aria-label="Breadcrumb" class="text-xs text-bondlio-gray">
                <a
                    href="/en"
                    class="hover:text-bondlio-orange transition-colors duration-150"
                    >Home</a
                >
                <span class="mx-2">/</span>
                <a
                    href="/en/infobook"
                    class="hover:text-bondlio-orange transition-colors duration-150"
                    >InfoBook</a
                >
                <span class="mx-2">/</span>
                <span class="text-bondlio-charcoal">{post.data.title}</span>
            </nav>

            <h1
                class="mt-2 text-3xl md:text-4xl font-display font-semibold text-bondlio-charcoal"
            >
                {post.data.h1 ?? post.data.title}
            </h1>
        </div>
    </section>

    <article class="page-content-container py-10">
        <div
            class="prose prose-lg max-w-3xl mx-auto prose-headings:font-display prose-headings:text-bondlio-charcoal prose-p:text-bondlio-gray prose-strong:text-bondlio-charcoal prose-a:text-bondlio-orange"
        >
            <Content />
        </div>
    </article>
</Layout>
