---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ContactForm from "../../components/ContactForm.astro";
import { getLangContent } from "../../i18n";

const lang = Astro.currentLocale ?? "tr";
const content = getLangContent(lang);
---

<Layout
    title="Contact | Bondlio"
    description="Contact us."
    currentPage="contact"
>
    <PageHeader
        title="Contact"
        description="For your questions, feel free to write to us. Open and honest communication is the best start."
    />

    <section class="page-content-container">
        <div class="grid lg:grid-cols-2 gap-16">
            <div>
                <h2
                    class="text-2xl font-display font-semibold text-bondlio-charcoal"
                >
                    Tell us about yourself.
                </h2>
                <p class="mt-3 text-bondlio-gray">
                    Whether you're looking for a family or a job opportunity —
                    fill out the form below, and our team will get back to you
                    as soon as possible. Every message is read by a real person.
                </p>
                <div class="mt-8">
                    <ContactForm />
                </div>
            </div>

            <div>
                <h2
                    class="text-2xl font-display font-semibold text-bondlio-charcoal"
                >
                    Contact Us
                </h2>
                <p class="mt-3 text-bondlio-gray">
                    For your questions, feel free to write. Open and honest
                    communication is the best start.
                </p>

                <div class="mt-8 space-y-6">
                    <div>
                        <h3
                            class="font-display font-semibold text-bondlio-charcoal"
                        >
                            E-mail
                        </h3>
                        <a
                            href="mailto:info@bondlio.com"
                            class="text-bondlio-gray hover:text-bondlio-orange transition-colors duration-150"
                        >
                            info@bondlio.com
                        </a>
                    </div>
                    <div>
                        <h3
                            class="font-display font-semibold text-bondlio-charcoal"
                        >
                            Phone
                        </h3>
                        <a
                            href={`tel:${content.contactInfo.phone}`}
                            class="text-bondlio-gray hover:text-bondlio-orange transition-colors duration-150"
                        >
                            {content.contactInfo.phoneDisplay}
                        </a>
                    </div>
                    <div>
                        <h3
                            class="font-display font-semibold text-bondlio-charcoal"
                        >
                            WhatsApp
                        </h3>
                        <a
                            href={`https://wa.me/${content.contactInfo.whatsapp}`}
                            target="_blank"
                            rel="noreferrer"
                            class="text-bondlio-gray hover:text-bondlio-orange transition-colors duration-150"
                        >
                            {content.contactInfo.whatsappDisplay}
                        </a>
                        <br />
                        <a
                            href={`https://wa.me/${content.contactInfo.whatsapp2}`}
                            target="_blank"
                            rel="noreferrer"
                            class="text-bondlio-gray hover:text-bondlio-orange transition-colors duration-150"
                        >
                            {content.contactInfo.whatsappDisplay2}
                        </a>
                    </div>
                    <div>
                        <h3
                            class="font-display font-semibold text-bondlio-charcoal"
                        >
                            Address
                        </h3>
                        <p class="text-bondlio-gray">
                            Park Oran Evleri, Çankaya, Ankara, Türkiye
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
