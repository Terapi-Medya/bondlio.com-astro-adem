---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getCollection } from "astro:content";
import ServiceCTA from "../../components/ServiceCTA.astro";

const allPosts = await getCollection("blog");
const posts = allPosts
    .filter((post) => post.data.lang === "en")
    .sort(
        (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
    );
---

<Layout
    title="InfoBook | Bondlio"
    description="Everything you'd want to know about care and home services."
    currentPage="infobook"
>
    <PageHeader
        title="InfoBook"
        description="Everything you'd want to know about care and home services."
    />

    <section class="page-content-container py-10">
        <div class="grid md:grid-cols-3 gap-8">
            {
                posts.map((post) => (
                    <a
                        href={`/en/infobook/${post.id}`}
                        class="group block bg-white border border-bondlio-beige rounded-2xl p-8 hover:border-bondlio-orange transition-colors duration-150"
                    >
                        <div class="bg-bondlio-beige rounded-xl aspect-[4/3] flex items-center justify-center mb-6">
                            <img
                                src={post.data.coverImage.src}
                                alt={post.data.title}
                                class="w-full h-full object-cover"
                            />
                        </div>
                        <time class="text-sm text-bondlio-gray">
                            {post.data.publishDate.toLocaleDateString("en-US", {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                            })}
                        </time>
                        <h2 class="mt-2 text-xl font-display font-semibold text-bondlio-charcoal">
                            {post.data.title}
                        </h2>
                        <p class="mt-2 text-bondlio-gray">
                            {post.data.description}
                        </p>
                        <span class="mt-4 inline-flex items-center gap-1 text-bondlio-orange font-display font-semibold group-hover:gap-2 transition-all duration-150">
                            Read More
                            <svg
                                class="w-4 h-4"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <line x1="5" y1="12" x2="19" y2="12" />
                                <polyline points="12 5 19 12 12 19" />
                            </svg>
                        </span>
                    </a>
                ))
            }
        </div>
    </section>

    <ServiceCTA />
</Layout>
