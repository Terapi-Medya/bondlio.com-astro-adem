---
import { getLangContent } from "../i18n";
import { tr } from "../i18n/tr";
import { en } from "../i18n/en";
import { tl } from "../i18n/tl";
import logo from "../assets/bondlio-logo-lightbg.webp";

interface Props {
	currentPage: string;
}

const { currentPage } = Astro.props;

const lang = Astro.currentLocale ?? "tr";
const content = getLangContent(lang);

function getRouteByKey(routes: typeof tr.routes, key: string): string {
	const keys = key.split(".");
	let value: any = routes;
	for (const k of keys) {
		value = value[k];
	}
	return value;
}

const languageLinks = [
	{ code: "tr", label: "TR", href: getRouteByKey(tr.routes, currentPage) },
	{ code: "en", label: "EN", href: getRouteByKey(en.routes, currentPage) },
	{ code: "tl", label: "TL", href: getRouteByKey(tl.routes, currentPage) },
];
---

<nav
	id="main-navbar"
	class="sticky top-0 bg-bondlio-cream z-50 transition-all duration-300"
>
	<div
		id="navbar-inner"
		class="max-w-[1440px] mx-auto flex items-center justify-between px-6 py-4 transition-all duration-300"
	>
		<a href={content.routes.home} class="relative z-50">
			<img src={logo.src} alt="Bondlio" class="h-10 w-auto" />
		</a>

		<!-- Desktop menu -->
		<ul class="hidden md:flex items-center gap-8 font-display">
			<li>
				<a
					href={content.routes.home}
					class="text-bondlio-charcoal hover:text-bondlio-orange transition-colors duration-150"
					>{content.nav.home}</a
				>
			</li>
			<li>
				<a
					href={content.routes.about}
					class="text-bondlio-charcoal hover:text-bondlio-orange transition-colors duration-150"
					>{content.nav.about}</a
				>
			</li>
			<li class="relative group">
				<a
					href={content.routes.services.index}
					class="flex items-center gap-1 text-bondlio-charcoal hover:text-bondlio-orange transition-colors duration-150"
				>
					{content.nav.services}
					<svg
						class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<polyline points="6 9 12 15 18 9"></polyline>
					</svg>
				</a>
				<div
					class="absolute left-0 top-full pt-4 w-48 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-opacity duration-150"
				>
					<ul
						class="bg-white border border-bondlio-beige rounded-lg shadow-lg py-2"
					>
						<li>
							<a
								href={content.routes.services.nanny}
								class="block px-4 py-2 text-bondlio-charcoal hover:bg-bondlio-beige"
							>
								{content.nav.servicesDropdown.nanny}
							</a>
						</li>
						<li>
							<a
								href={content.routes.services.caregiver}
								class="block px-4 py-2 text-bondlio-charcoal hover:bg-bondlio-beige"
							>
								{content.nav.servicesDropdown.caregiver}
							</a>
						</li>
						<li>
							<a
								href={content.routes.services.cleaner}
								class="block px-4 py-2 text-bondlio-charcoal hover:bg-bondlio-beige"
							>
								{content.nav.servicesDropdown.cleaner}
							</a>
						</li>
					</ul>
				</div>
			</li>
			<li>
				<a
					href={content.routes.infobook}
					class="text-bondlio-charcoal hover:text-bondlio-orange transition-colors duration-150"
					>{content.nav.infobook}</a
				>
			</li>
			<li>
				<a
					href={content.routes.contact}
					class="text-bondlio-charcoal hover:text-bondlio-orange transition-colors duration-150"
					>{content.nav.contact}</a
				>
			</li>
		</ul>

		<!-- Language switcher (desktop only) -->
		<div class="hidden md:flex items-center gap-3">
			<div class="relative group">
				<button
					class="flex items-center gap-1 text-bondlio-charcoal hover:text-bondlio-orange font-display"
				>
					{lang.toUpperCase()}
					<svg
						class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<polyline points="6 9 12 15 18 9"></polyline>
					</svg>
				</button>
				<div
					class="absolute right-0 top-full pt-4 w-24 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-opacity duration-150"
				>
					<ul
						class="bg-white border border-bondlio-beige rounded-lg shadow-lg py-2"
					>
						{
							languageLinks.map((item) => (
								<li>
									<a
										href={item.href}
										class="block px-4 py-2 text-bondlio-charcoal hover:bg-bondlio-beige text-sm"
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>

			<a
				href={content.routes.contact}
				class="px-5 py-2.5 bg-bondlio-orange text-white text-sm font-display font-semibold rounded-lg hover:bg-bondlio-darker-orange transition-colors duration-150"
			>
				{content.nav.getQuote}
			</a>
		</div>

		<!-- Mobile: language switcher + hamburger, right side -->
		<div class="flex items-center gap-4 md:hidden">
			<div class="relative">
				<button
					id="mobile-lang-toggle"
					class="flex items-center gap-1 text-bondlio-charcoal text-sm font-display font-medium"
					aria-expanded="false"
				>
					{lang.toUpperCase()}
					<svg
						id="mobile-lang-arrow"
						class="w-3 h-3 transition-transform duration-200"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<polyline points="6 9 12 15 18 9"></polyline>
					</svg>
				</button>
				<div
					id="mobile-lang-dropdown"
					class="hidden absolute right-0 top-full mt-2 w-24 z-50"
				>
					<ul
						class="bg-white border border-bondlio-beige rounded-lg shadow-lg py-2"
					>
						{
							languageLinks.map((item) => (
								<li>
									<a
										href={item.href}
										class="block px-4 py-2 text-bondlio-charcoal hover:bg-bondlio-beige text-sm"
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>

			<button
				id="mobile-menu-button"
				class="flex flex-col justify-center gap-1.5 w-7 h-7 shrink-0"
				aria-label="Menüyü aç"
				aria-expanded="false"
			>
				<span class="block w-6 h-0.5 bg-bondlio-charcoal"></span>
				<span class="block w-6 h-0.5 bg-bondlio-charcoal"></span>
				<span class="block w-6 h-0.5 bg-bondlio-charcoal"></span>
			</button>
		</div>
	</div>
	<!-- Mobile menu overlay - links only, sits BELOW the top bar -->
	<div
		id="mobile-menu"
		class="fixed top-[73px] left-0 right-0 bottom-0 bg-bondlio-cream z-40 translate-x-full transition-transform duration-300 md:hidden overflow-y-auto"
	>
		<ul class="flex flex-col items-center gap-6 mt-8 font-display">
			<li>
				<a href={content.routes.home} class="text-bondlio-charcoal"
					>{content.nav.home}</a
				>
			</li>
			<li>
				<a href={content.routes.about} class="text-bondlio-charcoal"
					>{content.nav.about}</a
				>
			</li>
			<li class="flex flex-col items-center">
				<button
					id="mobile-services-toggle"
					class="flex items-center gap-2 text-bondlio-charcoal"
					aria-expanded="false"
				>
					{content.nav.services}
					<svg
						id="mobile-services-arrow"
						class="w-4 h-4 transition-transform duration-200"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<polyline points="6 9 12 15 18 9"></polyline>
					</svg>
				</button>
				<ul
					id="mobile-services-submenu"
					class="hidden flex-col items-center gap-4 mt-4 text-base text-bondlio-gray"
				>
					<li>
						<a href={content.routes.services.nanny}
							>{content.nav.servicesDropdown.nanny}</a
						>
					</li>
					<li>
						<a href={content.routes.services.caregiver}
							>{content.nav.servicesDropdown.caregiver}</a
						>
					</li>
					<li>
						<a href={content.routes.services.cleaner}
							>{content.nav.servicesDropdown.cleaner}</a
						>
					</li>
				</ul>
			</li>
			<li>
				<a href={content.routes.infobook} class="text-bondlio-charcoal"
					>{content.nav.infobook}</a
				>
			</li>
			<li>
				<a href={content.routes.contact} class="text-bondlio-charcoal"
					>{content.nav.contact}</a
				>
			</li>
		</ul>

		<div class="px-6 mt-8">
			<a
				href={content.routes.contact}
				class="block text-center px-5 py-3 bg-bondlio-orange text-white font-display font-semibold rounded-lg hover:bg-bondlio-darker-orange transition-colors duration-150"
			>
				{content.nav.getQuote}
			</a>
		</div>
	</div>
</nav>

<script>
	const menuButton = document.getElementById("mobile-menu-button");
	const mobileMenu = document.getElementById("mobile-menu");

	function toggleMenu() {
		const isOpen = mobileMenu?.classList.contains("translate-x-0");
		if (isOpen) {
			mobileMenu?.classList.remove("translate-x-0");
			mobileMenu?.classList.add("translate-x-full");
			menuButton?.setAttribute("aria-expanded", "false");
		} else {
			mobileMenu?.classList.remove("translate-x-full");
			mobileMenu?.classList.add("translate-x-0");
			menuButton?.setAttribute("aria-expanded", "true");
		}
	}

	menuButton?.addEventListener("click", toggleMenu);

	const servicesToggle = document.getElementById("mobile-services-toggle");
	const servicesSubmenu = document.getElementById("mobile-services-submenu");
	const servicesArrow = document.getElementById("mobile-services-arrow");

	servicesToggle?.addEventListener("click", () => {
		const isOpen = servicesSubmenu?.classList.contains("flex");
		if (isOpen) {
			servicesSubmenu?.classList.remove("flex");
			servicesSubmenu?.classList.add("hidden");
			servicesArrow?.classList.remove("rotate-180");
			servicesToggle?.setAttribute("aria-expanded", "false");
		} else {
			servicesSubmenu?.classList.remove("hidden");
			servicesSubmenu?.classList.add("flex");
			servicesArrow?.classList.add("rotate-180");
			servicesToggle?.setAttribute("aria-expanded", "true");
		}
	});

	const mobileLangToggle = document.getElementById("mobile-lang-toggle");
	const mobileLangDropdown = document.getElementById("mobile-lang-dropdown");
	const mobileLangArrow = document.getElementById("mobile-lang-arrow");

	mobileLangToggle?.addEventListener("click", () => {
		const isOpen = !mobileLangDropdown?.classList.contains("hidden");
		if (isOpen) {
			mobileLangDropdown?.classList.add("hidden");
			mobileLangArrow?.classList.remove("rotate-180");
			mobileLangToggle?.setAttribute("aria-expanded", "false");
		} else {
			mobileLangDropdown?.classList.remove("hidden");
			mobileLangArrow?.classList.add("rotate-180");
			mobileLangToggle?.setAttribute("aria-expanded", "true");
		}
	});

	const navbar = document.getElementById("main-navbar");
	const navbarInner = document.getElementById("navbar-inner");

	function handleScroll() {
		if (window.scrollY > 20) {
			navbarInner?.classList.remove("py-4");
			navbarInner?.classList.add("py-2");
		} else {
			navbarInner?.classList.remove("py-2");
			navbarInner?.classList.add("py-4");
		}
	}

	window.addEventListener("scroll", handleScroll);
	handleScroll();
</script>
