---
import { getLangContent } from "../i18n";

const lang = Astro.currentLocale ?? "tr";
const content = getLangContent(lang);
---

<section class="page-content-container py-16">
    <div class="bg-bondlio-orange rounded-3xl px-6 py-12 md:py-16">
        <div class="max-w-2xl mx-auto text-center">
            <p
                class="text-2xl md:text-3xl font-display font-semibold text-white leading-snug"
            >
                "{content.homepage.aboutQuote}"
            </p>
            <a
                href={content.routes.about}
                class="mt-10 inline-flex items-center gap-1 text-bondlio-charcoal bg-white rounded-full px-4 py-2 md:px-8 md:py-4 font-display font-semibold hover:gap-2 transition-all duration-150"
            >
                {content.homepage.aboutCtaText}
                <svg
                    class="w-4 h-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>
    </div>
</section>
