---
import { getLangContent } from "../i18n";
import { getServices } from "../data/services";

const lang = Astro.currentLocale ?? "tr";
const content = getLangContent(lang);
const services = getServices(content);
---

<section class="page-content-container py-16">
    <div class="max-w-2xl">
        <h2
            class="text-2xl md:text-4xl font-display font-semibold text-bondlio-charcoal"
        >
            {content.homepage.servicesPreviewTitle}
        </h2>
        <p class="mt-3 text-bondlio-gray">
            {content.homepage.servicesPreviewSubtitle}
        </p>
    </div>

    <div class="mt-7 grid md:grid-cols-3 gap-8">
        {
            services.map((service) => (
                <a
                    href={service.href}
                    class="group block bg-white border border-bondlio-beige rounded-2xl p-8 hover:border-bondlio-orange transition-colors duration-150"
                >
                    <div class="bg-bondlio-beige rounded-xl aspect-[4/3] overflow-hidden mb-6">
                        <img
                            src={service.image.src}
                            alt={service.title}
                            class="w-full h-full object-cover"
                        />
                    </div>
                    <h3 class="text-xl font-display font-semibold text-bondlio-charcoal">
                        {service.title}
                    </h3>
                    <p class="mt-2 text-bondlio-gray">{service.description}</p>
                    <span class="mt-4 inline-flex items-center gap-1 text-bondlio-orange font-display font-semibold group-hover:gap-2 transition-all duration-150">
                        {content.homepage.viewDetailsText}
                        <svg
                            class="w-4 h-4"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <line x1="5" y1="12" x2="19" y2="12" />
                            <polyline points="12 5 19 12 12 19" />
                        </svg>
                    </span>
                </a>
            ))
        }
    </div>
</section>
