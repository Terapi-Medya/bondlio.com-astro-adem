---
import { getLangContent } from "../i18n";

interface Props {
    checks: { title: string; description: string }[];
}

const { checks } = Astro.props;

const lang = Astro.currentLocale ?? "tr";
const content = getLangContent(lang);
---

<section class="page-content-container py-10">
    <h2
        class="text-2xl md:text-3xl font-display font-semibold text-bondlio-charcoal"
    >
        {content.serviceProcess.title}
    </h2>
    <p class="mt-3 text-bondlio-gray max-w-2xl">
        {content.serviceProcess.subtitle}
    </p>

    <div class="mt-10 grid md:grid-cols-2 gap-x-12 gap-y-8">
        {
            checks.map((check) => (
                <div class="flex gap-4">
                    <svg
                        class="w-6 h-6 shrink-0 text-bondlio-orange mt-0.5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        aria-hidden="true"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                            clip-rule="evenodd"
                        />
                    </svg>
                    <div>
                        <h3 class="font-display font-semibold text-bondlio-charcoal">
                            {check.title}
                        </h3>
                        <p class="mt-1 text-bondlio-gray text-sm">
                            {check.description}
                        </p>
                    </div>
                </div>
            ))
        }
    </div>
</section>
