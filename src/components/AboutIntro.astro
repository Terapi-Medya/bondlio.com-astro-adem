---
import { getLangContent } from "../i18n";

const lang = Astro.currentLocale ?? "tr";
const content = getLangContent(lang);
import bondlioAgency from "../assets/bondlio-agency.webp";
---

<section class="py-5 md:py-10">
    <div class="max-w-[1440px] mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-x-12 gap-y-12 items-center">
            <div>
                <h2
                    class="text-sm font-display font-semibold text-bondlio-orange uppercase tracking-wide"
                >
                    {content.about.eyebrow}
                </h2>
                <p
                    class="mt-2 text-3xl md:text-4xl font-display font-bold text-bondlio-charcoal text-balance"
                >
                    {content.about.title}
                </p>
                <p class="mt-6 text-lg text-bondlio-gray">
                    {content.about.intro}
                </p>

                <dl class="mt-10 space-y-6">
                    {
                        content.about.features.map((feature) => (
                            <div class="relative pl-9">
                                <dt class="inline font-display font-semibold text-bondlio-charcoal">
                                    <svg
                                        viewBox="0 0 20 20"
                                        fill="currentColor"
                                        aria-hidden="true"
                                        class="absolute top-1 left-0 size-5 text-bondlio-orange"
                                    >
                                        <path
                                            fill-rule="evenodd"
                                            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                                            clip-rule="evenodd"
                                        />
                                    </svg>
                                    {feature.title}
                                </dt>
                                <dd class="inline text-bondlio-gray">
                                    {" "}
                                    {feature.description}
                                </dd>
                            </div>
                        ))
                    }
                </dl>

                <p
                    class="mt-10 text-lg font-display font-semibold text-bondlio-charcoal"
                >
                    {content.about.closingQuote}
                </p>
            </div>

            <div
                class="bg-bondlio-beige rounded-2xl aspect-[4/3] overflow-hidden"
            >
                <img
                    src={bondlioAgency.src}
                    alt="Bondlio"
                    class="w-full h-full object-cover"
                />
            </div>
        </div>
    </div>
</section>
