---
import { getLangContent } from "../i18n";
import HeroSlider from "./HeroSlider.astro";
import HomeForms from "./HomeForms.astro";

const lang = Astro.currentLocale ?? "tr";
const content = getLangContent(lang);
---

<section class="px-6 pt-6 pb-16 md:pb-20 bg-bondlio-cream">
    <div class="mx-auto max-w-[1440px]">
        <HeroSlider />

        <div class="relative isolate mt-8 py-8 overflow-hidden">
            <div class="max-w-4xl mx-auto text-center">
                <h1
                    class="text-4xl md:text-6xl font-display font-bold text-bondlio-charcoal leading-tight text-balance"
                >
                    {content.homepage.heroTitle}
                </h1>
                <p
                    class="mt-6 text-lg md:text-xl text-bondlio-gray text-pretty"
                >
                    {content.homepage.heroSubtitle}
                </p>
            </div>
        </div>

        <div class="mt-4">
            <HomeForms />
        </div>
    </div>
</section>
