---
import { getCollection } from "astro:content";
import { getLangContent } from "../i18n";

const lang = Astro.currentLocale ?? "tr";
const content = getLangContent(lang);

const allPosts = await getCollection("blog");
const posts = allPosts
    .filter((post) => post.data.lang === lang)
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
    .slice(0, 3);
---

<section class="page-content-container py-16">
    <div class="max-w-2xl">
        <h2
            class="text-2xl md:text-4xl font-display font-semibold text-bondlio-charcoal"
        >
            {content.homepage.blogPreviewTitle}
        </h2>
        <p class="mt-3 text-bondlio-gray">
            {content.homepage.blogPreviewSubtitle}
        </p>
    </div>

    <div class="mt-7 grid md:grid-cols-3 gap-8">
        {
            posts.map((post) => (
                <a
                    href={`/bilgi-defteri/${post.id}`}
                    class="group block bg-white border border-bondlio-beige rounded-2xl p-8 hover:border-bondlio-orange transition-colors duration-150"
                >
                    <div class="bg-bondlio-beige rounded-xl aspect-[4/3] overflow-hidden mb-6">
                        <img
                            src={post.data.coverImage.src}
                            alt={post.data.title}
                            class="w-full h-full object-cover"
                        />
                    </div>
                    <h3 class="text-lg font-display font-semibold text-bondlio-charcoal">
                        {post.data.title}
                    </h3>
                    <p class="mt-2 text-sm text-bondlio-gray line-clamp-2">
                        {post.data.description}
                    </p>
                </a>
            ))
        }
    </div>
</section>
