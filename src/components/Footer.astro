---
import { getLangContent } from "../i18n";
import logo from "../assets/bondlio-logo-lightbg.webp";

const lang = Astro.currentLocale ?? "tr";
const content = getLangContent(lang);

const currentYear = new Date().getFullYear();
---

<footer>
    <div
        class="mx-auto max-w-[1440px] px-6 pt-16 pb-6 lg:pt-24 border-t border-bondlio-beige pt-6"
    >
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
            <div>
                <div class="flex justify-center sm:justify-start">
                    <a href={content.routes.home}>
                        <img src={logo.src} alt="Bondlio" class="h-10 w-auto" />
                    </a>
                </div>

                <p
                    class="mt-6 max-w-md text-center leading-relaxed text-bondlio-gray sm:max-w-xs sm:text-left"
                >
                    {content.footer.tagline}
                </p>

                <ul
                    class="mt-8 flex justify-center gap-6 sm:justify-start md:gap-8"
                >
                    <li>
                        <a
                            href="https://instagram.com/bondlio"
                            rel="noreferrer"
                            target="_blank"
                            class="text-bondlio-charcoal transition hover:text-bondlio-orange"
                        >
                            <span class="sr-only">Instagram</span>
                            <svg
                                class="size-6"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"
                                    clip-rule="evenodd"></path>
                            </svg>
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://facebook.com/bondlio"
                            rel="noreferrer"
                            target="_blank"
                            class="text-bondlio-charcoal transition hover:text-bondlio-orange"
                        >
                            <span class="sr-only">Facebook</span>
                            <svg
                                class="size-6"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"
                                    clip-rule="evenodd"></path>
                            </svg>
                        </a>
                    </li>
                    <li>
                        <a
                            href="https://linkedin.com/company/bondlio"
                            rel="noreferrer"
                            target="_blank"
                            class="text-bondlio-charcoal transition hover:text-bondlio-orange"
                        >
                            <span class="sr-only">LinkedIn</span>
                            <svg
                                class="size-6"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <path
                                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                                ></path>
                            </svg>
                        </a>
                    </li>
                </ul>
            </div>

            <div
                class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-[1fr_1fr_1fr_1.7fr] lg:col-span-2"
            >
                <div class="text-center sm:text-left">
                    <p
                        class="text-lg font-display font-medium text-bondlio-charcoal"
                    >
                        Bondlio
                    </p>
                    <ul class="mt-8 space-y-4 text-sm">
                        <li>
                            <a
                                class="text-bondlio-gray transition hover:text-bondlio-orange"
                                href={content.routes.home}
                            >
                                {content.nav.home}
                            </a>
                        </li>
                        <li>
                            <a
                                class="text-bondlio-gray transition hover:text-bondlio-orange"
                                href={content.routes.about}
                            >
                                {content.nav.about}
                            </a>
                        </li>
                        <li>
                            <a
                                class="text-bondlio-gray transition hover:text-bondlio-orange"
                                href={content.routes.infobook}
                            >
                                {content.nav.infobook}
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="text-center sm:text-left">
                    <p
                        class="text-lg font-display font-medium text-bondlio-charcoal"
                    >
                        {content.nav.services}
                    </p>
                    <ul class="mt-8 space-y-4 text-sm">
                        <li>
                            <a
                                class="text-bondlio-gray transition hover:text-bondlio-orange"
                                href={content.routes.services.nanny}
                            >
                                {content.nav.servicesDropdown.nanny}
                            </a>
                        </li>
                        <li>
                            <a
                                class="text-bondlio-gray transition hover:text-bondlio-orange"
                                href={content.routes.services.caregiver}
                            >
                                {content.nav.servicesDropdown.caregiver}
                            </a>
                        </li>
                        <li>
                            <a
                                class="text-bondlio-gray transition hover:text-bondlio-orange"
                                href={content.routes.services.cleaner}
                            >
                                {content.nav.servicesDropdown.cleaner}
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="text-center sm:text-left">
                    <p
                        class="text-lg font-display font-medium text-bondlio-charcoal"
                    >
                        {content.footer.quickLinks}
                    </p>
                    <ul class="mt-8 space-y-4 text-sm">
                        <li>
                            <a
                                class="text-bondlio-gray transition hover:text-bondlio-orange"
                                href={content.routes.contact}
                            >
                                {content.nav.contact}
                            </a>
                        </li>
                        <li>
                            <a
                                class="text-bondlio-gray transition hover:text-bondlio-orange"
                                href={content.routes.privacy}
                            >
                                {content.footer.privacyLabel}
                            </a>
                        </li>
                        <li>
                            <a
                                class="text-bondlio-gray transition hover:text-bondlio-orange"
                                href={content.routes.terms}
                            >
                                {content.footer.termsLabel}
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="text-center sm:text-left">
                    <p
                        class="text-lg font-display font-medium text-bondlio-charcoal"
                    >
                        {content.footer.contactTitle}
                    </p>
                    <ul class="mt-8 space-y-4 text-sm">
                        <li>
                            <a
                                class="flex items-center justify-center gap-1.5 sm:justify-start"
                                href="mailto:info@bondlio.com"
                            >
                                <svg
                                    aria-hidden="true"
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="size-5 shrink-0 text-bondlio-charcoal"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                    ></path>
                                </svg>
                                <span class="text-bondlio-gray"
                                    >info@bondlio.com</span
                                >
                            </a>
                        </li>
                        <li>
                            <a
                                class="flex items-center justify-center gap-1.5 sm:justify-start"
                                href={`tel:${content.contactInfo.phone}`}
                            >
                                <svg
                                    aria-hidden="true"
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="size-5 shrink-0 text-bondlio-charcoal"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                    ></path>
                                </svg>
                                <span class="text-bondlio-gray"
                                    >{content.contactInfo.phoneDisplay}</span
                                >
                            </a>
                        </li>
                        <li>
                            <a
                                class="flex items-center justify-center gap-1.5 sm:justify-start"
                                href={`https://wa.me/${content.contactInfo.whatsapp}`}
                                target="_blank"
                                rel="noreferrer"
                            >
                                <svg
                                    aria-hidden="true"
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="size-5 shrink-0 text-bondlio-charcoal"
                                    viewBox="0 0 24 24"
                                    fill="currentColor"
                                >
                                    <path
                                        d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm5.8 14.14c-.24.68-1.4 1.3-1.93 1.38-.49.08-1.11.11-1.79-.11-.41-.13-.94-.31-1.62-.6-2.85-1.23-4.71-4.1-4.85-4.29-.14-.19-1.16-1.54-1.16-2.94 0-1.4.73-2.08 1-2.37.26-.28.57-.35.76-.35s.38 0 .55.01c.18.01.41-.07.64.49.24.57.81 1.98.88 2.12.07.14.12.31.02.5-.09.19-.14.31-.28.47-.14.17-.29.37-.42.5-.14.14-.28.29-.12.57.16.28.71 1.17 1.52 1.9 1.05.94 1.93 1.23 2.21 1.37.28.14.45.12.61-.07.16-.19.68-.79.87-1.06.18-.28.36-.23.61-.14.24.09 1.55.73 1.82.87.27.14.44.21.51.32.07.11.07.65-.17 1.31z"
                                    ></path>
                                </svg>
                                <span class="text-bondlio-gray"
                                    >{content.contactInfo.whatsappDisplay}</span
                                >
                            </a>
                        </li>
                        <li
                            class="flex items-start justify-center gap-1.5 sm:justify-start"
                        >
                            <svg
                                aria-hidden="true"
                                xmlns="http://www.w3.org/2000/svg"
                                class="size-5 shrink-0 text-bondlio-charcoal"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                ></path>
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            <address
                                class="-mt-0.5 text-bondlio-gray not-italic"
                            >
                                Park Oran Evleri, Çankaya, Ankara, Türkiye
                            </address>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="mt-12 border-t border-bondlio-beige pt-6">
            <div class="text-center sm:flex sm:justify-between sm:text-left">
                <p class="text-sm text-bondlio-gray">
                    <span class="block sm:inline">
                        {content.footer.allRightsReserved}&nbsp;
                    </span>
                    <a
                        class="inline-block text-bondlio-orange underline transition hover:text-bondlio-charcoal"
                        href={content.routes.terms}
                    >
                        {content.footer.termsLabel}
                    </a>
                    <span> &middot; </span>
                    <a
                        class="inline-block text-bondlio-orange underline transition hover:text-bondlio-charcoal"
                        href={content.routes.privacy}
                    >
                        {content.footer.privacyLabel}
                    </a>
                </p>
                <p
                    class="mt-4 text-sm text-bondlio-gray sm:order-first sm:mt-0"
                >
                    &copy; {currentYear} Bondlio
                </p>
            </div>
        </div>
    </div>
</footer>
