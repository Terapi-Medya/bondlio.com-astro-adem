---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";

interface Props {
	lang?: string;
	title: string;
	description: string;
	currentPage: string;
}

const { lang, title, description, currentPage } = Astro.props;

const currentLang = lang ?? Astro.currentLocale ?? "tr";
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body class="bg-bondlio-cream font-body text-bondlio-charcoal">
		<Navbar currentPage={currentPage} />
		<slot />
		<Footer />
		<FloatingWhatsApp />
	</body>
</html>

<style></style>
