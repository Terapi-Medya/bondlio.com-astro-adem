---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import ServiceCTA from "../components/ServiceCTA.astro";

interface Props {
	lang?: string;
	title: string;
	description: string;
	currentPage: string;
}

const { lang, title, description, currentPage } = Astro.props;

const currentLang = lang ?? Astro.currentLocale ?? "tr";
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- Meta Pixel Code -->
		<script>
			!(function (f, b, e, v, n, t, s) {
				if (f.fbq) return;
				n = f.fbq = function () {
					n.callMethod
						? n.callMethod.apply(n, arguments)
						: n.queue.push(arguments);
				};
				if (!f._fbq) f._fbq = n;
				n.push = n;
				n.loaded = !0;
				n.version = "2.0";
				n.queue = [];
				t = b.createElement(e);
				t.async = !0;
				t.src = v;
				s = b.getElementsByTagName(e)[0];
				s.parentNode.insertBefore(t, s);
			})(
				window,
				document,
				"script",
				"https://connect.facebook.net/en_US/fbevents.js",
			);
			fbq("init", "1420297637826926");
			fbq("track", "PageView");
		</script>
		<noscript
			><img
				height="1"
				width="1"
				style="display:none"
				src="https://www.facebook.com/tr?id=1420297637826926&ev=PageView&noscript=1"
			/></noscript
		>
		<!-- End Meta Pixel Code -->
	</head>
	<body class="bg-bondlio-cream font-body text-bondlio-charcoal">
		<Navbar currentPage={currentPage} />
		<slot />
		<section class="page-content-container py-5">
			<ServiceCTA />
		</section>
		<Footer />
		<FloatingWhatsApp />
	</body>
</html>

<style></style>
